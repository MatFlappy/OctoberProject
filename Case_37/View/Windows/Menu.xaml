<Window x:Class="Case_37.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Case_37"
        mc:Ignorable="d"
        Title="Menu" Height="1080" Width="1920" WindowStartupLocation="CenterScreen" MinHeight="1000" MinWidth="1900">
    <Grid Background="#3c3c3c">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="0.1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="0.1*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="SteachTb" Text="Введите название"
                 Grid.Column="1" Margin="80"/>
        <ListBox x:Name="Lst" Grid.Column="1" Grid.Row="1"                   
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True"
                    Margin="0"
                    HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5" Height="550" Width="450" Background="Gray">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Image Margin="10"
                            Grid.Column="1" Source="{Binding Photo}" Height="200" Width="200"/>
                        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical">
                            <TextBlock Text="{Binding Name}" FontSize="36" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Category.Title}" FontSize="14"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Grid.Row="2"
                                   Text="{Binding Descrition}" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="1" Grid.Row="3"
                                   Text="{Binding Price}" FontSize="24"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
