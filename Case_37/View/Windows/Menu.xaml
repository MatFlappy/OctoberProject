<Window x:Class="Case_37.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Case_37"
        mc:Ignorable="d"
        Title="Menu" Height="1080" Width="1920">
    <Grid Background="#3c3c3c">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="0.1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/> 
            <RowDefinition Height="2*"/>
            <RowDefinition Height="0.1*"/>
        </Grid.RowDefinitions>
        <TextBox Grid.Column="1" Margin="80"/>
        <ListBox x:Name="Lst" Grid.Row="1" Grid.Column="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="550" Width="450" Margin="5" Background="#3c3c3c">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Image Source="{Binding Photo}" Height="200" Width="200" Grid.Column="1"/>

                        <StackPanel Orientation="Vertical" Grid.Column="1" Grid.Row="1">
                            <TextBlock Text="{Binding Name}" FontSize="36" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Category.Title}" FontSize="14"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Descrition}" Grid.Column="1" Grid.Row="2" TextWrapping="Wrap"  FontSize="14"/>
                        <TextBlock Text="{Binding Price}" Grid.Column="1" Grid.Row="3"  FontSize="24"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
 